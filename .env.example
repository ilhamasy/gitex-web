# Server Configuration
PORT=3000
NODE_ENV=development

# AI Provider Selection ('anthropic' or 'gemini')
AI_PROVIDER=anthropic

# Anthropic Claude Configuration
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_TIMEOUT_MS=90000

# Google Gemini Configuration
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_MS=60000

# Repository Providers (Optional - for increased rate limits on public repositories)
GITHUB_TOKEN=
GITLAB_TOKEN=

# Ingestion Limits (Optional)
MAX_TREE_ENTRIES=1000
MAX_RELEVANT_FILES=50
MAX_FILE_SIZE_BYTES=102400
