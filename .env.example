# Server Configuration
PORT=3000
NODE_ENV=development

# AI Provider Configuration (Google Gemini Developer API)
# Get your API key with Developer API quota at https://aistudio.google.com
# NOTE: A Google AI Pro subscription does not grant Developer API quota.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=60000

# Repository Providers (Optional - for increased rate limits on public repositories)
GITHUB_TOKEN=
GITLAB_TOKEN=

# Ingestion Limits (Optional)
MAX_TREE_ENTRIES=1000
MAX_RELEVANT_FILES=50
MAX_FILE_SIZE_BYTES=102400

