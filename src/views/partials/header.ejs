<header class="app-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="GitEx Home">
      <span>GitEx</span>
      <span class="brand-tag">Field Notebook</span>
    </a>
    <div class="header-actions">
      <button id="theme-toggle" class="btn-ghost" type="button" aria-label="Switch to light theme">
        <span id="theme-icon" aria-hidden="true">☀️</span>
        <span id="theme-label">Light</span>
      </button>
      <script>
        (function(){try{var t=document.documentElement.getAttribute('data-theme')||localStorage.getItem('gitex_theme')||localStorage.getItem('gitex.theme');if(t==='light'){var i=document.getElementById('theme-icon'),l=document.getElementById('theme-label'),b=document.getElementById('theme-toggle');if(i)i.textContent='🌙';if(l)l.textContent='Dark';if(b)b.setAttribute('aria-label','Switch to dark theme');}}catch(e){}})();
      </script>
    </div>
  </div>
</header>
