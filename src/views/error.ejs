<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <script>
    (function(){try{var t=localStorage.getItem('gitex_theme')||localStorage.getItem('gitex.theme');if(t==='light'||t==='dark'){document.documentElement.setAttribute('data-theme',t);}}catch(e){}})();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css?v=gitex-v3">
  <script src="/js/theme.js"></script>
</head>
<body>
  <%- include('partials/header') %>

  <main class="app-main">
    <div class="container">
      <div class="surface-card" style="border-left: 4px solid var(--color-danger);">
        <h1 style="font-size: 1.5rem; margin-bottom: 0.5rem; font-weight: 600;">Error <%= statusCode %></h1>
        <p style="color: var(--color-text-secondary); margin-bottom: 1.5rem;"><%= message %></p>
        <a href="/" style="display: inline-block; background-color: var(--color-surface-muted); color: var(--color-text-primary); text-decoration: none; padding: 0.5rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--color-border); font-size: 0.875rem;">
          Return to Dashboard
        </a>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>

