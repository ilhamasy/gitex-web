<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <script>
    (function(){try{var t=localStorage.getItem('gitex_theme')||localStorage.getItem('gitex.theme');if(t==='light'||t==='dark'){document.documentElement.setAttribute('data-theme',t);}}catch(e){}})();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="GitEx — Every Repository, Explained. Understand any codebase without getting lost in the code.">
  <title><%= title || 'GitEx — Every Repository, Explained.' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/theme.js"></script>
</head>
<body class="landing-page">
  <!-- Interactive Vanta.js NET Background -->
  <div id="vanta-net-bg" class="landing-vanta-canvas" aria-hidden="true"></div>

  <!-- Foreground Content -->
  <div class="landing-shell">
    <!-- Navbar: GitEx wordmark & controls -->
    <header class="app-header landing-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="GitEx Home">
          <span>GitEx</span>
          <span class="brand-tag">Field Notebook</span>
        </a>
        <div class="header-actions">
          <button id="theme-toggle" class="btn-ghost" type="button" aria-label="Switch to light theme">
            <span id="theme-icon" aria-hidden="true">☀️</span>
            <span id="theme-label">Light</span>
          </button>
          <a href="/app" class="btn btn-accent btn-sm landing-nav-cta">Get Started →</a>
        </div>
      </div>
    </header>

    <main id="main-content" class="landing-main">
      <!-- Hero Section -->
      <section class="landing-hero-section" aria-labelledby="hero-title">
        <div class="container landing-hero-container">
          <div class="landing-hero-badge font-mono">
            <span class="hero-pulse-dot" aria-hidden="true"></span>
            <span>REPOSITORY KNOWLEDGE ENGINE</span>
          </div>

          <h1 id="hero-title" class="landing-hero-title">
            GitEx<span class="title-bracket">[plain]</span>
          </h1>

          <p class="landing-hero-tagline">
            Every Repository, Explained.
          </p>

          <p class="landing-hero-lead">
            Understand any codebase without getting lost in the code.
          </p>

          <p class="landing-hero-desc">
            GitEx transforms GitHub and GitLab repositories into clear, structured technical guides. Discover what a project does, how it works, what you need, and how to get started.
          </p>

          <div class="landing-hero-actions">
            <a href="/app" class="btn btn-accent btn-hero-cta" id="btn-hero-get-started">
              <span>Get Started</span>
              <span class="cta-arrow" aria-hidden="true">→</span>
            </a>
          </div>

          <p class="landing-hero-subtext font-mono">
            Explore repositories. Understand technology. Build with confidence.
          </p>
        </div>
      </section>

      <!-- How It Works Section -->
      <section class="landing-section" id="how-it-works" aria-labelledby="heading-how-it-works">
        <div class="container">
          <div class="section-label-row">
            <span class="landing-badge font-mono">// WORKFLOW</span>
          </div>
          <h2 id="heading-how-it-works" class="landing-section-title">How it works</h2>
          <p class="landing-section-subtitle font-mono">
            Paste repository → Analyze → Understand.
          </p>

          <div class="workflow-grid">
            <div class="workflow-card">
              <div class="workflow-step-num font-mono">01</div>
              <h3 class="workflow-step-title">Paste repository</h3>
              <p class="workflow-step-text">
                Provide any public GitHub or GitLab URL. GitEx automatically normalizes branches, commits, and sub-paths.
              </p>
            </div>

            <div class="workflow-arrow" aria-hidden="true">→</div>

            <div class="workflow-card">
              <div class="workflow-step-num font-mono">02</div>
              <h3 class="workflow-step-title">Analyze</h3>
              <p class="workflow-step-text">
                Tree prioritization and Repomix context bundling feed into Gemini 2.5 Flash to extract operational architecture.
              </p>
            </div>

            <div class="workflow-arrow" aria-hidden="true">→</div>

            <div class="workflow-card">
              <div class="workflow-step-num font-mono">03</div>
              <h3 class="workflow-step-title">Understand</h3>
              <p class="workflow-step-text">
                Read a concise, verified technical breakdown structured across clean engineering sections with zero AI fluff.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- What You'll Get Section -->
      <section class="landing-section" id="what-you-get" aria-labelledby="heading-what-you-get">
        <div class="container">
          <div class="section-label-row">
            <span class="landing-badge font-mono">// DELIVERABLES</span>
          </div>
          <h2 id="heading-what-you-get" class="landing-section-title">What you'll get</h2>
          <p class="landing-section-subtitle">
            Overview, Features, Architecture, Prerequisites, Installation, Usage.
          </p>

          <div class="deliverables-grid">
            <div class="deliverable-card">
              <div class="deliverable-header font-mono">
                <span class="deliverable-num">01</span>
                <span class="deliverable-tag">CORE</span>
              </div>
              <h3 class="deliverable-title">Overview</h3>
              <p class="deliverable-desc">
                High-level repository summary, primary project goals, target problem domain, and intended users.
              </p>
            </div>

            <div class="deliverable-card">
              <div class="deliverable-header font-mono">
                <span class="deliverable-num">02</span>
                <span class="deliverable-tag">CAPABILITIES</span>
              </div>
              <h3 class="deliverable-title">Features</h3>
              <p class="deliverable-desc">
                Core features, key capabilities, distinguishing characteristics, and functional strengths.
              </p>
            </div>

            <div class="deliverable-card">
              <div class="deliverable-header font-mono">
                <span class="deliverable-num">03</span>
                <span class="deliverable-tag">SYSTEM</span>
              </div>
              <h3 class="deliverable-title">Architecture</h3>
              <p class="deliverable-desc">
                How the codebase works under the hood, key module components, data flow, and runtime mechanics.
              </p>
            </div>

            <div class="deliverable-card">
              <div class="deliverable-header font-mono">
                <span class="deliverable-num">04</span>
                <span class="deliverable-tag">REQUIREMENTS</span>
              </div>
              <h3 class="deliverable-title">Prerequisites</h3>
              <p class="deliverable-desc">
                Required runtime environments, languages, SDKs, external dependencies, and system tools.
              </p>
            </div>

            <div class="deliverable-card">
              <div class="deliverable-header font-mono">
                <span class="deliverable-num">05</span>
                <span class="deliverable-tag">SETUP</span>
              </div>
              <h3 class="deliverable-title">Installation</h3>
              <p class="deliverable-desc">
                Step-by-step setup guides, package commands, build procedures, and configuration caveats.
              </p>
            </div>

            <div class="deliverable-card">
              <div class="deliverable-header font-mono">
                <span class="deliverable-num">06</span>
                <span class="deliverable-tag">EXECUTION</span>
              </div>
              <h3 class="deliverable-title">Usage</h3>
              <p class="deliverable-desc">
                Quickstart workflows, essential CLI commands, and runnable practical code examples.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Supported Platforms Section -->
      <section class="landing-section" id="supported-platforms" aria-labelledby="heading-platforms">
        <div class="container">
          <div class="section-label-row">
            <span class="landing-badge font-mono">// INTEGRATIONS</span>
          </div>
          <h2 id="heading-platforms" class="landing-section-title">Supported platforms</h2>
          <p class="landing-section-subtitle">
            Seamless analysis for repositories across major Git providers.
          </p>

          <div class="platforms-grid">
            <div class="platform-card">
              <div class="platform-icon-wrap">
                <svg class="platform-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                </svg>
              </div>
              <div class="platform-info">
                <h3 class="platform-name">GitHub</h3>
                <p class="platform-desc">
                  Public repositories, HTTPS URLs, SSH syntax, tree exploration, and commit SHA tracking.
                </p>
              </div>
            </div>

            <div class="platform-card">
              <div class="platform-icon-wrap">
                <svg class="platform-icon is-gitlab" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M22.65 14.39L12 22.13 1.35 14.39a.84.84 0 0 1-.3-.94l1.22-3.78 2.44-7.51c.06-.18.19-.32.36-.39a.77.77 0 0 1 .5.03c.17.07.3.2.36.38l2.42 7.45h7.3l2.42-7.45c.06-.18.19-.31.36-.38a.77.77 0 0 1 .5-.03c.17.07.3.21.36.39l2.44 7.51 1.22 3.78c.07.24 0 .5-.3.94z"/>
                </svg>
              </div>
              <div class="platform-info">
                <h3 class="platform-name">GitLab</h3>
                <p class="platform-desc">
                  Public projects, nested groups and subgroups, community editions, and direct commit refs.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Bottom Launch Callout -->
      <section class="landing-launch-banner">
        <div class="container launch-container">
          <div class="launch-card">
            <h2 class="launch-title">Every repository, explained in seconds.</h2>
            <p class="launch-desc">
              Paste any GitHub or GitLab URL and explore technical architecture with complete clarity.
            </p>
            <a href="/app" class="btn btn-accent btn-hero-cta">
              <span>Get Started</span>
              <span class="cta-arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <%- include('partials/footer') %>
  </div>

  <!-- Three.js + Vanta.js NET Scripts -->
  <script src="/vendor/three.r134.min.js"></script>
  <script src="/vendor/vanta.net.min.js"></script>
  <script src="/js/landing.vanta.js"></script>
</body>
</html>
