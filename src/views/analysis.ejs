<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <script>
    (function(){try{var t=localStorage.getItem('gitex_theme')||localStorage.getItem('gitex.theme');if(t==='light'||t==='dark'){document.documentElement.setAttribute('data-theme',t);}}catch(e){}})();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="GitEx — Repository Analysis Document">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v=gitex-v9">
  <link rel="stylesheet" href="/css/graph-explorer.css?v=gitex-v9">
  <script src="/js/theme.js"></script>
  <script>
    (function(){
      try {
        var t = new URLSearchParams(window.location.search).get('tab');
        if (t !== 'docs') {
          document.documentElement.classList.add('tab-graph-active');
        }
      } catch(e) {}

      function updateHeaderHeight() {
        var h = document.getElementById('analysis-top');
        if (h) {
          document.documentElement.style.setProperty('--analysis-header-height', h.offsetHeight + 'px');
        }
      }
      window.addEventListener('resize', updateHeaderHeight, { passive: true });
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', updateHeaderHeight);
      } else {
        updateHeaderHeight();
      }
      setTimeout(updateHeaderHeight, 100);
    })();
  </script>
</head>
<body class="analysis-page">
  <%- include('partials/header') %>

  <!-- Top Analysis Identity Bar -->
  <header class="analysis-header-bar" id="analysis-top">
    <div class="container analysis-header-inner">
      <div class="analysis-breadcrumb-row">
        <a href="/app" class="back-link">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          <span>Dashboard</span>
        </a>

        <div class="header-meta-actions">
          <!-- Language Switcher (EN default / ID) -->
          <div class="lang-switch-group" role="group" aria-label="Language selection">
            <button type="button" id="btn-lang-en" class="lang-btn <%= (!currentLang || currentLang === 'en') ? 'active' : '' %>" aria-pressed="<%= (!currentLang || currentLang === 'en') ? 'true' : 'false' %>" title="English" onclick="if(window.switchLanguage){window.switchLanguage('en',true);}">
              <span class="flag-icon" aria-hidden="true">🇬🇧</span>
              <span class="lang-label">EN</span>
            </button>
            <button type="button" id="btn-lang-id" class="lang-btn <%= currentLang === 'id' ? 'active' : '' %>" aria-pressed="<%= currentLang === 'id' ? 'true' : 'false' %>" title="Bahasa Indonesia" onclick="if(window.switchLanguage){window.switchLanguage('id',true);}">
              <span class="flag-icon" aria-hidden="true">🇮🇩</span>
              <span class="lang-label">ID</span>
            </button>
          </div>
          <script>
            (function(){
              try {
                var savedLang = localStorage.getItem('gitex_lang') || new URLSearchParams(window.location.search).get('lang') || '<%= typeof currentLang !== "undefined" ? currentLang : "en" %>';
                var isId = (savedLang === 'id');
                var btnEn = document.getElementById('btn-lang-en');
                var btnId = document.getElementById('btn-lang-id');
                if (btnEn && btnId) {
                  btnEn.classList.toggle('active', !isId);
                  btnEn.setAttribute('aria-pressed', !isId ? 'true' : 'false');
                  btnId.classList.toggle('active', isId);
                  btnId.setAttribute('aria-pressed', isId ? 'true' : 'false');
                }
              } catch(e) {}
            })();

            window.switchLanguage = window.switchLanguage || function(targetLang) {
              try {
                localStorage.setItem('gitex_lang', targetLang);
                var isId = (targetLang === 'id');
                var btnEn = document.getElementById('btn-lang-en');
                var btnId = document.getElementById('btn-lang-id');
                if (btnEn && btnId) {
                  btnEn.classList.toggle('active', !isId);
                  btnEn.setAttribute('aria-pressed', !isId ? 'true' : 'false');
                  btnId.classList.toggle('active', isId);
                  btnId.setAttribute('aria-pressed', isId ? 'true' : 'false');
                }
                var url = new URL(window.location.href);
                if (isId) url.searchParams.set('lang', 'id');
                else url.searchParams.delete('lang');
                window.location.href = url.toString();
              } catch(e) {}
            };
          </script>

          <% if (record) { %>
            <a href="<%= record.url %>" target="_blank" rel="noopener noreferrer" class="appbar-btn" id="link-repo-provider" title="Open repository in new tab">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
              </svg>
              <span class="btn-text">View on <%= record.provider === 'gitlab' ? 'GitLab' : 'GitHub' %></span>
            </a>
          <% } %>

          <button type="button" id="btn-copy-markdown" class="appbar-btn" title="Copy raw analysis markdown">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
            </svg>
            <span class="btn-text">Copy Markdown</span>
          </button>
          
          <button type="button" id="btn-reanalyze" class="appbar-btn btn-reanalyze" title="Re-run analysis for this repository">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
            </svg>
            <span class="btn-text">Re-analyze</span>
          </button>

          <button type="button" id="btn-delete-analysis" class="appbar-btn btn-delete-analysis" title="Delete this analysis and start fresh">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
            <span class="btn-text">Delete</span>
          </button>
        </div>
      </div>

      <div class="analysis-identity-row" id="analysis-identity-container">
        <% if (record) { %>
          <div class="repo-identity">
            <h1 class="repo-title" id="repo-title"><%= record.fullName %></h1>
            <div class="repo-meta-badges">
              <span class="badge badge-citrus" id="provider-badge"><%= record.provider.toUpperCase() %></span>
              <% if (record.revision && record.revision !== 'unknown') { %>
                <span class="badge" title="Analyzed Commit SHA">
                  SHA: <%= record.revision.substring(0, 7) %>
                </span>
              <% } %>
              <% if (record.language) { %>
                <span class="badge"><%= record.language %></span>
              <% } %>
              <% if (record.stars !== undefined && record.stars !== null) { %>
                <span class="badge">★ <%= record.stars %></span>
              <% } %>
              <% if (record.license) { %>
                <span class="badge"><%= record.license %></span>
              <% } %>
              <% if (record.status === 'completed') { %>
                <span class="badge badge-success">Completed</span>
              <% } else if (record.status === 'partial') { %>
                <span class="badge badge-amber">Partial</span>
              <% } else { %>
                <span class="badge badge-danger">Incomplete</span>
              <% } %>
            </div>
          </div>
        <% } else { %>
          <!-- Client-side hydration placeholder -->
          <div class="repo-identity" id="client-hydration-header">
            <h1 class="repo-title" id="repo-title">Loading repository analysis...</h1>
            <div class="repo-meta-badges" id="dynamic-badges"></div>
          </div>
        <% } %>
      </div>

      <!-- Top-Level Navigation Tabs: Graph Explorer | Documentation -->
      <nav class="top-nav-tabs-wrapper" role="tablist" aria-label="Analysis Mode">
        <button type="button" id="tab-nav-graph" class="top-nav-tab active" role="tab" aria-selected="true" aria-controls="graph-explorer-workspace">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <circle cx="6" cy="12" r="3" stroke-width="2" />
            <circle cx="18" cy="6" r="3" stroke-width="2" />
            <circle cx="18" cy="18" r="3" stroke-width="2" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.7 10.7l6.6-3.4M8.7 13.3l6.6 3.4" />
          </svg>
          <span>Graph Explorer</span>
        </button>
        <button type="button" id="tab-nav-docs" class="top-nav-tab" role="tab" aria-selected="false" aria-controls="main-content">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Documentation</span>
          <span class="tab-badge" id="docs-tab-badge">12</span>
        </button>
      </nav>
    </div>
  </header>

  <!-- Dedicated Graph Explorer Workspace -->
  <%- include('partials/graph-explorer') %>

  <!-- Mobile Table of Contents Bar -->
  <div class="mobile-toc-bar">
    <button type="button" id="btn-toggle-mobile-toc" class="btn-toggle-mobile-toc" aria-expanded="false" aria-controls="toc-rail" onclick="window.toggleGitExMobileToc()">
      <span class="btn-toc-left">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path>
        </svg>
        <span>Table of Contents</span>
      </span>
      <span class="btn-toc-chevron" aria-hidden="true">▼</span>
    </button>
  </div>
  <script>
    window.toggleGitExMobileToc = function(force) {
      var rail = document.getElementById('toc-rail');
      var btn = document.getElementById('btn-toggle-mobile-toc');
      if (!rail) return;
      var shouldOpen = typeof force === 'boolean' ? force : !rail.classList.contains('open');
      if (shouldOpen) {
        rail.classList.add('open');
        if (btn) btn.setAttribute('aria-expanded', 'true');
        document.body.classList.add('mobile-toc-open');
      } else {
        rail.classList.remove('open');
        if (btn) btn.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('mobile-toc-open');
        document.body.style.overflow = '';
      }
    };
  </script>

  <!-- Main Analysis Workspace -->
  <main class="container analysis-workspace-grid with-evidence" id="main-content">
    <%
    function toArr(v) {
      if (!v) return [];
      return Array.isArray(v) ? v : [v];
    }

    function formatItem(item) {
      if (!item) return '';
      if (typeof item === 'string') return item.trim();
      if (typeof item === 'object') {
        const name = item.name || item.title || '';
        const desc = item.description || item.purpose || item.distinction || '';
        if (name && desc) return '<strong>' + name + ':</strong> ' + desc;
        return name || desc || '';
      }
      return String(item);
    }

    function hasContent(val) {
      if (!val) return false;
      if (typeof val === 'string') {
        const trimmed = val.trim();
        return trimmed.length > 0 && trimmed !== 'Not documented' && trimmed !== 'Not documented.' && trimmed !== 'N/A' && trimmed !== '[object Object]';
      }
      if (Array.isArray(val)) {
        return val.some(hasContent);
      }
      if (typeof val === 'object') {
        return Object.values(val).some(hasContent);
      }
      return true;
    }

    function isSectionVisible(key, analysis) {
      if (!analysis) return true;
      const sec = analysis[key];
      if (!sec) return false;

      switch (key) {
        case 'overview':
          return hasContent(sec.summary) || hasContent(sec.problemSolved) || hasContent(sec.mainGoal);
        case 'purpose':
          return (sec.targetUsers || []).some(hasContent) ||
                 (sec.capabilities || []).some(hasContent) ||
                 (sec.scenarios || []).some(hasContent);
        case 'features':
          return (sec.coreFeatures || []).some(hasContent) ||
                 (sec.uniqueCapabilities || []).some(hasContent);
        case 'howItWorks':
          return hasContent(sec.architecture) ||
                 (sec.components || []).some(hasContent) ||
                 hasContent(sec.dataFlow);
        case 'prerequisites':
          return hasContent(sec.runtime) ||
                 (sec.languages || []).some(hasContent) ||
                 (sec.tools || []).some(hasContent) ||
                 (sec.system || []).some(hasContent);
        case 'installation':
          return (sec.steps || []).some(hasContent) ||
                 (sec.caveats || []).some(hasContent);
        case 'configuration':
          return (sec.configFiles || []).some(hasContent) ||
                 (sec.environmentVariables || []).some(hasContent) ||
                 (sec.secrets || []).some(hasContent);
        case 'usage':
          return hasContent(sec.quickStart) ||
                 (sec.commonCommands || []).some(hasContent) ||
                 (sec.codeExamples || []).some(hasContent);
        case 'techStack':
          return (sec.languages || []).some(hasContent) ||
                 (sec.frameworks || []).some(hasContent) ||
                 (sec.libraries || []).some(hasContent) ||
                 (sec.infrastructure || []).some(hasContent);
        case 'limitations':
          return toArr(sec.knownLimitations || sec.documentedLimitations).some(hasContent) ||
                 toArr(sec.compatibility || sec.compatibilityNotes).some(hasContent) ||
                 toArr(sec.securityCaveats || sec.securityNotes).some(hasContent) ||
                 hasContent(sec.productionReadiness);
        case 'alternatives':
          return toArr(sec.comparableProjects || sec.similarProjects).some(hasContent) ||
                 hasContent(sec.distinctions);
        case 'resources':
          return hasContent(sec.documentationUrl) ||
                 hasContent(sec.issueTrackerUrl) ||
                 (sec.communityLinks || []).some(hasContent);
        default:
          return Object.entries(sec).some(([k, v]) => k !== 'title' && k !== 'sources' && k !== 'isIncomplete' && k !== 'status' && hasContent(v));
      }
    }

    const sectionsList = [
      { key: 'overview', title: 'Repository Overview' },
      { key: 'purpose', title: 'Purpose & Use Cases' },
      { key: 'features', title: 'Key Features' },
      { key: 'howItWorks', title: 'How It Works' },
      { key: 'prerequisites', title: 'Prerequisites' },
      { key: 'installation', title: 'Installation Guide' },
      { key: 'configuration', title: 'Configuration' },
      { key: 'usage', title: 'Usage & Examples' },
      { key: 'techStack', title: 'Tech Stack' },
      { key: 'limitations', title: 'Limitations & Considerations' },
      { key: 'alternatives', title: 'Alternatives' },
      { key: 'resources', title: 'Official Resources' },
    ];

    const rawVisible = record && record.analysis ? sectionsList.filter(s => isSectionVisible(s.key, record.analysis)) : sectionsList;
    const visibleSections = rawVisible.map((sec, idx) => ({
      ...sec,
      title: (typeof currentLang !== 'undefined' && currentLang === 'id' && typeof sectionTitlesId !== 'undefined' && sectionTitlesId[sec.key])
        ? sectionTitlesId[sec.key]
        : ((typeof sectionTitles !== 'undefined' && sectionTitles[sec.key]) || sec.title),
      num: String(idx + 1).padStart(2, '0'),
    }));
    const sectionNumMap = Object.fromEntries(visibleSections.map(s => [s.key, s.num]));
    %>
    <!-- Left Navigation Rail (Table of Contents) -->
    <nav class="analysis-toc-rail" id="toc-rail" aria-label="Analysis Sections">
      <div class="toc-header">
        <span>Table of Contents</span>
        <button type="button" id="btn-close-mobile-toc" class="btn-close-mobile-toc" aria-label="Close table of contents" onclick="window.toggleGitExMobileToc(false)">✕</button>
      </div>
      <ol class="toc-list" id="toc-list">
        <% visibleSections.forEach(sec => { %>
          <li>
            <a href="#section-<%= sec.key %>" class="toc-link" data-section="<%= sec.key %>">
              <span class="toc-num"><%= sec.num %></span>
              <span class="toc-title"><%= sec.title %></span>
            </a>
          </li>
        <% }); %>
      </ol>
    </nav>

    <!-- Center Reading Column -->
    <article class="analysis-document-column" id="analysis-document">
      <% if (record && record.analysis) { %>

        <!-- 01. Repository Overview -->
        <% const overview = record.analysis.overview || {}; %>
        <% if (isSectionVisible('overview', record.analysis)) { %>
        <section class="analysis-section" id="section-overview" aria-labelledby="heading-overview">
          <header class="section-header-row">
            <div class="section-title-wrap">
              <span class="section-number"><%= sectionNumMap['overview'] %></span>
              <h2 id="heading-overview" class="section-title"><%= overview.title || 'Repository Overview' %></h2>
            </div>
            <% if (overview.isIncomplete || overview.status === 'not_documented') { %>
              <span class="badge badge-amber">Not documented</span>
            <% } %>
          </header>
          <div class="section-body">
            <% if (overview.isIncomplete || overview.status === 'not_documented') { %>
              <div class="section-incomplete-notice">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                <span>Repository overview could not be verified from repository documentation.</span>
              </div>
            <% } %>
            <% if (overview.summary && hasContent(overview.summary)) { %>
              <div class="prose-block">
                <%- markdownService.render(overview.summary) %>
              </div>
            <% } %>

            <% if (overview.problemSolved && hasContent(overview.problemSolved)) { %>
              <h3>Problem Solved</h3>
              <div class="prose-block">
                <%- markdownService.render(overview.problemSolved) %>
              </div>
            <% } %>

            <% if (overview.mainGoal && hasContent(overview.mainGoal)) { %>
              <h3>Main Goal</h3>
              <div class="prose-block">
                <%- markdownService.render(overview.mainGoal) %>
              </div>
            <% } %>

            <% if (overview.sources && overview.sources.filter(hasContent).length > 0) { %>
              <div class="section-sources-row">
                <span class="sources-label">Sources:</span>
                <% overview.sources.filter(hasContent).forEach(src => { %>
                  <%- markdownService.renderSourceBadge(src, record.url) %>
                <% }); %>
              </div>
            <% } %>
          </div>
        </section>
        <% } %>

        <!-- 02. Purpose & Use Cases -->
        <% const purpose = record.analysis.purpose || {}; %>
        <% if (isSectionVisible('purpose', record.analysis)) { %>
        <section class="analysis-section" id="section-purpose" aria-labelledby="heading-purpose">
          <header class="section-header-row">
            <div class="section-title-wrap">
              <span class="section-number"><%= sectionNumMap['purpose'] %></span>
              <h2 id="heading-purpose" class="section-title"><%= purpose.title || 'Purpose & Use Cases' %></h2>
            </div>
            <% if (purpose.isIncomplete || purpose.status === 'not_documented') { %>
              <span class="badge badge-amber">Not documented</span>
            <% } %>
          </header>
          <div class="section-body">
            <% 
              const validUsers = (purpose.targetUsers || []).filter(hasContent);
              if (validUsers.length > 0) { 
            %>
              <h3>Target Users</h3>
              <ul>
                <% validUsers.forEach(user => { %>
                  <li><%- formatItem(user) %></li>
                <% }); %>
              </ul>
            <% } %>

            <% 
              const validCaps = (purpose.capabilities || []).filter(hasContent);
              if (validCaps.length > 0) { 
            %>
              <h3>Core Capabilities</h3>
              <ul>
                <% validCaps.forEach(cap => { %>
                  <li><%- formatItem(cap) %></li>
                <% }); %>
              </ul>
            <% } %>

            <% 
              const validScenarios = (purpose.scenarios || []).filter(hasContent);
              if (validScenarios.length > 0) { 
            %>
              <h3>Real-World Scenarios</h3>
              <ul>
                <% validScenarios.forEach(scen => { %>
                  <li><%- formatItem(scen) %></li>
                <% }); %>
              </ul>
            <% } %>

            <% if (purpose.sources && purpose.sources.filter(hasContent).length > 0) { %>
              <div class="section-sources-row">
                <span class="sources-label">Sources:</span>
                <% purpose.sources.filter(hasContent).forEach(src => { %>
                  <%- markdownService.renderSourceBadge(src, record.url) %>
                <% }); %>
              </div>
            <% } %>
          </div>
        </section>
        <% } %>

        <!-- 03. Key Features -->
        <% const features = record.analysis.features || {}; %>
        <% if (isSectionVisible('features', record.analysis)) { %>
        <section class="analysis-section" id="section-features" aria-labelledby="heading-features">
          <header class="section-header-row">
            <div class="section-title-wrap">
              <span class="section-number"><%= sectionNumMap['features'] %></span>
              <h2 id="heading-features" class="section-title"><%= features.title || 'Key Features' %></h2>
            </div>
            <% if (features.isIncomplete || features.status === 'not_documented') { %>
              <span class="badge badge-amber">Not documented</span>
            <% } %>
          </header>
          <div class="section-body">
            <% 
              const validCoreFeatures = (features.coreFeatures || []).filter(hasContent);
              if (validCoreFeatures.length > 0) { 
            %>
              <h3>Core Features</h3>
              <ul>
                <% validCoreFeatures.forEach(feat => { %>
                  <li><%- formatItem(feat) %></li>
                <% }); %>
              </ul>
            <% } %>

            <% 
              const validUnique = (features.uniqueCapabilities || []).filter(hasContent);
              if (validUnique.length > 0) { 
            %>
              <h3>Distinct Capabilities</h3>
              <ul>
                <% validUnique.forEach(uc => { %>
                  <li><%- formatItem(uc) %></li>
                <% }); %>
              </ul>
            <% } %>

            <% if (features.sources && features.sources.filter(hasContent).length > 0) { %>
              <div class="section-sources-row">
                <span class="sources-label">Sources:</span>
                <% features.sources.filter(hasContent).forEach(src => { %>
                  <%- markdownService.renderSourceBadge(src, record.url) %>
                <% }); %>
              </div>
            <% } %>
          </div>
        </section>
        <% } %>

        <!-- 04. How It Works -->
        <% const howItWorks = record.analysis.howItWorks || {}; %>
        <% if (isSectionVisible('howItWorks', record.analysis)) { %>
        <section class="analysis-section" id="section-howItWorks" aria-labelledby="heading-howItWorks">
          <header class="section-header-row">
            <div class="section-title-wrap">
              <span class="section-number"><%= sectionNumMap['howItWorks'] %></span>
              <h2 id="heading-howItWorks" class="section-title"><%= howItWorks.title || 'How It Works' %></h2>
            </div>
            <% if (howItWorks.isIncomplete || howItWorks.status === 'not_documented') { %>
              <span class="badge badge-amber">Not documented</span>
            <% } %>
          </header>
          <div class="section-body">
            <% if (howItWorks.architecture && hasContent(howItWorks.architecture)) { %>
              <h3>Architecture</h3>
              <div class="prose-block">
                <%- markdownService.render(howItWorks.architecture) %>
              </div>
            <% } %>

            <% 
              const validComponents = (howItWorks.components || []).filter(hasContent);
              if (validComponents.length > 0) { 
            %>
              <h3>Key Components</h3>
              <ul>
                <% validComponents.forEach(comp => { %>
                  <li>
                    <%- formatItem(comp) %>
                    <% if (comp.path) { %>
                      <%- markdownService.renderSourceBadge(comp.path, record.url) %>
                    <% } %>
                  </li>
                <% }); %>
              </ul>
            <% } %>

            <% if (howItWorks.dataFlow && hasContent(howItWorks.dataFlow)) { %>
              <h3>Data Flow</h3>
              <div class="prose-block">
                <%- markdownService.render(howItWorks.dataFlow) %>
              </div>
            <% } %>

            <% if (howItWorks.sources && howItWorks.sources.filter(hasContent).length > 0) { %>
              <div class="section-sources-row">
                <span class="sources-label">Sources:</span>
                <% howItWorks.sources.filter(hasContent).forEach(src => { %>
                  <%- markdownService.renderSourceBadge(src, record.url) %>
                <% }); %>
              </div>
            <% } %>
          </div>
        </section>
        <% } %>

        <!-- 05. Prerequisites -->
        <% const prerequisites = record.analysis.prerequisites || {}; %>
        <% if (isSectionVisible('prerequisites', record.analysis)) { %>
        <section class="analysis-section" id="section-prerequisites" aria-labelledby="heading-prerequisites">
          <header class="section-header-row">
            <div class="section-title-wrap">
              <span class="section-number"><%= sectionNumMap['prerequisites'] %></span>
              <h2 id="heading-prerequisites" class="section-title"><%= prerequisites.title || 'Prerequisites' %></h2>
            </div>
            <% if (prerequisites.isIncomplete || prerequisites.status === 'not_documented') { %>
              <span class="badge badge-amber">Not documented</span>
            <% } %>
          </header>
          <div class="section-body">
            <% if (prerequisites.runtime && hasContent(prerequisites.runtime)) { %>
              <p><strong>Runtime:</strong> <%= prerequisites.runtime %></p>
            <% } %>

            <% 
              const validLangs = (prerequisites.languages || []).filter(hasContent);
              if (validLangs.length > 0) { 
            %>
              <p><strong>Required Languages:</strong> <%= validLangs.map(formatItem).join(', ') %></p>
            <% } %>

            <% 
              const validTools = (prerequisites.tools || []).filter(hasContent);
              if (validTools.length > 0) { 
            %>
              <h3>Required Tools</h3>
              <ul>
                <% validTools.forEach(tool => { %>
                  <li><%- formatItem(tool) %></li>
                <% }); %>
              </ul>
            <% } %>

            <% 
              const validSys = (prerequisites.system || []).filter(hasContent);
              if (validSys.length > 0) { 
            %>
              <h3>System Requirements</h3>
              <ul>
                <% validSys.forEach(sys => { %>
                  <li><%- formatItem(sys) %></li>
                <% }); %>
              </ul>
            <% } %>

            <% if (prerequisites.sources && prerequisites.sources.filter(hasContent).length > 0) { %>
              <div class="section-sources-row">
                <span class="sources-label">Sources:</span>
                <% prerequisites.sources.filter(hasContent).forEach(src => { %>
                  <%- markdownService.renderSourceBadge(src, record.url) %>
                <% }); %>
              </div>
            <% } %>
          </div>
        </section>
        <% } %>

        <!-- 06. Installation Guide -->
        <% const installation = record.analysis.installation || {}; %>
        <% if (isSectionVisible('installation', record.analysis)) { %>
        <section class="analysis-section" id="section-installation" aria-labelledby="heading-installation">
          <header class="section-header-row">
            <div class="section-title-wrap">
              <span class="section-number"><%= sectionNumMap['installation'] %></span>
              <h2 id="heading-installation" class="section-title"><%= installation.title || 'Installation Guide' %></h2>
            </div>
            <% if (installation.isIncomplete || installation.status === 'not_documented') { %>
              <span class="badge badge-amber">Not documented</span>
            <% } %>
          </header>
          <div class="section-body">
            <% 
              const validSteps = (installation.steps || []).filter(hasContent);
              if (validSteps.length > 0) { 
            %>
              <% validSteps.forEach((st, idx) => { 
                  const stepNum = st.step || st.stepNumber || (idx + 1);
                  const stepTitle = st.title || st.name || st.description || ('Step ' + stepNum);
                  const stepInstructions = st.instructions || (st.title && st.description ? st.description : '');
              %>
                <div class="install-step-item">
                  <div class="install-step-header">
                    <span class="install-step-num"><%= stepNum %></span>
                    <span class="install-step-title"><%= stepTitle %></span>
                  </div>
                  <% if (stepInstructions && hasContent(stepInstructions)) { %>
                    <p class="text-sm text-text-secondary my-1.5"><%= stepInstructions %></p>
                  <% } %>
                  <% if (st.command && hasContent(st.command)) { %>
                    <%- markdownService.render('```bash\n' + st.command + '\n```') %>
                  <% } %>
                  <% if (st.verification && hasContent(st.verification)) { %>
                    <p class="text-xs text-text-secondary"><strong>Verification:</strong> <%= st.verification %></p>
                  <% } %>
                </div>
              <% }); %>
            <% } %>

            <% 
              const validCaveats = (installation.caveats || []).filter(hasContent);
              if (validCaveats.length > 0) { 
            %>
              <div class="callout-recommendation">
                <div class="callout-title">Setup Caveats & Recommendations</div>
                <ul>
                  <% validCaveats.forEach(cav => { %>
                    <li><%- formatItem(cav) %></li>
                  <% }); %>
                </ul>
              </div>
            <% } %>

            <% if (installation.sources && installation.sources.filter(hasContent).length > 0) { %>
              <div class="section-sources-row">
                <span class="sources-label">Sources:</span>
                <% installation.sources.filter(hasContent).forEach(src => { %>
                  <%- markdownService.renderSourceBadge(src, record.url) %>
                <% }); %>
              </div>
            <% } %>
          </div>
        </section>
        <% } %>

        <!-- 07. Configuration -->
        <% const configuration = record.analysis.configuration || {}; %>
        <% if (isSectionVisible('configuration', record.analysis)) { %>
        <section class="analysis-section" id="section-configuration" aria-labelledby="heading-configuration">
          <header class="section-header-row">
            <div class="section-title-wrap">
              <span class="section-number"><%= sectionNumMap['configuration'] %></span>
              <h2 id="heading-configuration" class="section-title"><%= configuration.title || 'Configuration' %></h2>
            </div>
            <% if (configuration.isIncomplete || configuration.status === 'not_documented') { %>
              <span class="badge badge-amber">Not documented</span>
            <% } %>
          </header>
          <div class="section-body">
            <% 
              const validConfigs = (configuration.configFiles || []).filter(hasContent);
              if (validConfigs.length > 0) { 
            %>
              <h3>Configuration Files</h3>
              <ul>
                <% validConfigs.forEach(cf => { %>
                  <li>
                    <code><%= cf.path || cf.name || '' %></code><% if (cf.purpose || cf.description) { %>: <%= cf.purpose || cf.description %><% } %>
                    <% if (cf.path) { %>
                      <%- markdownService.renderSourceBadge(cf.path, record.url) %>
                    <% } %>
                  </li>
                <% }); %>
              </ul>
            <% } %>

            <% 
              const validEnvs = (configuration.environmentVariables || []).filter(hasContent);
              if (validEnvs.length > 0) { 
            %>
              <h3>Environment Variables</h3>
              <ul>
                <% validEnvs.forEach(ev => { %>
                  <li>
                    <code><%= ev.name %></code><% if (ev.description) { %>: <%= ev.description %><% } %>
                    <% if (ev.default) { %> <em>(default: <code><%= ev.default %></code>)</em><% } %>
                  </li>
                <% }); %>
              </ul>
            <% } %>

            <% 
              const validSecrets = (configuration.secrets || []).filter(hasContent);
              if (validSecrets.length > 0) { 
            %>
              <h3>Required Secrets & Tokens</h3>
              <ul>
                <% validSecrets.forEach(sec => { %>
                  <li><code><%- formatItem(sec) %></code></li>
                <% }); %>
              </ul>
            <% } %>

            <% if (configuration.sources && configuration.sources.filter(hasContent).length > 0) { %>
              <div class="section-sources-row">
                <span class="sources-label">Sources:</span>
                <% configuration.sources.filter(hasContent).forEach(src => { %>
                  <%- markdownService.renderSourceBadge(src, record.url) %>
                <% }); %>
              </div>
            <% } %>
          </div>
        </section>
        <% } %>

        <!-- 08. Usage & Examples -->
        <% const usage = record.analysis.usage || {}; %>
        <% if (isSectionVisible('usage', record.analysis)) { %>
        <section class="analysis-section" id="section-usage" aria-labelledby="heading-usage">
          <header class="section-header-row">
            <div class="section-title-wrap">
              <span class="section-number"><%= sectionNumMap['usage'] %></span>
              <h2 id="heading-usage" class="section-title"><%= usage.title || 'Usage & Examples' %></h2>
            </div>
            <% if (usage.isIncomplete || usage.status === 'not_documented') { %>
              <span class="badge badge-amber">Not documented</span>
            <% } %>
          </header>
          <div class="section-body">
            <% if (usage.quickStart && hasContent(usage.quickStart)) { %>
              <h3>Quick Start</h3>
              <div class="prose-block">
                <%- markdownService.render(usage.quickStart) %>
              </div>
            <% } %>

            <% 
              const validCommands = (usage.commonCommands || []).filter(hasContent);
              if (validCommands.length > 0) { 
            %>
              <h3>Common Commands</h3>
              <ul>
                <% validCommands.forEach(cmd => { %>
                  <li>
                    <% if (cmd.description) { %><strong><%= cmd.description %>:</strong><% } %>
                    <% if (cmd.command) { %><%- markdownService.render('```bash\n' + cmd.command + '\n```') %><% } %>
                  </li>
                <% }); %>
              </ul>
            <% } %>

            <% 
              const validExamples = (usage.codeExamples || []).filter(hasContent);
              if (validExamples.length > 0) { 
            %>
              <h3>Code Examples</h3>
              <% validExamples.forEach(ex => { %>
                <% if (ex.title) { %><p><strong><%= ex.title %>:</strong></p><% } %>
                <% if (ex.code) { %><%- markdownService.render('```' + (ex.language || '') + '\n' + ex.code + '\n```') %><% } %>
              <% }); %>
            <% } %>

            <% if (usage.sources && usage.sources.filter(hasContent).length > 0) { %>
              <div class="section-sources-row">
                <span class="sources-label">Sources:</span>
                <% usage.sources.filter(hasContent).forEach(src => { %>
                  <%- markdownService.renderSourceBadge(src, record.url) %>
                <% }); %>
              </div>
            <% } %>
          </div>
        </section>
        <% } %>

        <!-- 09. Tech Stack -->
        <% const techStack = record.analysis.techStack || {}; %>
        <% if (isSectionVisible('techStack', record.analysis)) { %>
        <section class="analysis-section" id="section-techStack" aria-labelledby="heading-techStack">
          <header class="section-header-row">
            <div class="section-title-wrap">
              <span class="section-number"><%= sectionNumMap['techStack'] %></span>
              <h2 id="heading-techStack" class="section-title"><%= techStack.title || 'Tech Stack' %></h2>
            </div>
            <% if (techStack.isIncomplete || techStack.status === 'not_documented') { %>
              <span class="badge badge-amber">Not documented</span>
            <% } %>
          </header>
          <div class="section-body">
            <% 
              const validLanguages = (techStack.languages || []).filter(hasContent);
              if (validLanguages.length > 0) { 
            %>
              <p><strong>Languages:</strong> <%= validLanguages.map(formatItem).join(', ') %></p>
            <% } %>

            <% 
              const validFrameworks = (techStack.frameworks || []).filter(hasContent);
              if (validFrameworks.length > 0) { 
            %>
              <p><strong>Frameworks:</strong> <%= validFrameworks.map(formatItem).join(', ') %></p>
            <% } %>

            <% 
              const validLibraries = (techStack.libraries || []).filter(hasContent);
              if (validLibraries.length > 0) { 
            %>
              <h3>Key Libraries & Dependencies</h3>
              <ul>
                <% validLibraries.forEach(lib => { %>
                  <li>
                    <code><%= lib.name || '' %></code><% if (lib.version) { %> (<%= lib.version %>)<% } %><% if (lib.purpose || lib.description) { %>: <%= lib.purpose || lib.description %><% } %>
                  </li>
                <% }); %>
              </ul>
            <% } %>

            <% 
              const validInfra = (techStack.infrastructure || []).filter(hasContent);
              if (validInfra.length > 0) { 
            %>
              <p><strong>Infrastructure / Tooling:</strong> <%= validInfra.map(formatItem).join(', ') %></p>
            <% } %>

            <% if (techStack.sources && techStack.sources.filter(hasContent).length > 0) { %>
              <div class="section-sources-row">
                <span class="sources-label">Sources:</span>
                <% techStack.sources.filter(hasContent).forEach(src => { %>
                  <%- markdownService.renderSourceBadge(src, record.url) %>
                <% }); %>
              </div>
            <% } %>
          </div>
        </section>
        <% } %>

        <!-- 10. Limitations & Considerations -->
        <% const limitations = record.analysis.limitations || {}; %>
        <% if (isSectionVisible('limitations', record.analysis)) { %>
        <section class="analysis-section" id="section-limitations" aria-labelledby="heading-limitations">
          <header class="section-header-row">
            <div class="section-title-wrap">
              <span class="section-number"><%= sectionNumMap['limitations'] %></span>
              <h2 id="heading-limitations" class="section-title"><%= limitations.title || 'Limitations & Considerations' %></h2>
            </div>
            <% if (limitations.isIncomplete || limitations.status === 'not_documented') { %>
              <span class="badge badge-amber">Not documented</span>
            <% } %>
          </header>
          <div class="section-body">
            <% 
              const validLimitations = toArr(limitations.knownLimitations || limitations.documentedLimitations).filter(hasContent);
              if (validLimitations.length > 0) { 
            %>
              <h3>Known Limitations</h3>
              <ul>
                <% validLimitations.forEach(lim => { %>
                  <li><%- formatItem(lim) %></li>
                <% }); %>
              </ul>
            <% } %>

            <% 
              const validCompatibility = toArr(limitations.compatibility || limitations.compatibilityNotes).filter(hasContent);
              if (validCompatibility.length > 0) { 
            %>
              <h3>Compatibility Notes</h3>
              <ul>
                <% validCompatibility.forEach(comp => { %>
                  <li><%- formatItem(comp) %></li>
                <% }); %>
              </ul>
            <% } %>

            <% 
              const validSecurity = toArr(limitations.securityCaveats || limitations.securityNotes).filter(hasContent);
              if (validSecurity.length > 0) { 
            %>
              <h3>Security Caveats</h3>
              <ul>
                <% validSecurity.forEach(sec => { %>
                  <li><%- formatItem(sec) %></li>
                <% }); %>
              </ul>
            <% } %>

            <% if (limitations.productionReadiness && hasContent(limitations.productionReadiness)) { %>
              <div class="callout-recommendation">
                <div class="callout-title">Production Readiness Assessment</div>
                <p><%= limitations.productionReadiness %></p>
              </div>
            <% } %>

            <% if (limitations.sources && limitations.sources.filter(hasContent).length > 0) { %>
              <div class="section-sources-row">
                <span class="sources-label">Sources:</span>
                <% limitations.sources.filter(hasContent).forEach(src => { %>
                  <%- markdownService.renderSourceBadge(src, record.url) %>
                <% }); %>
              </div>
            <% } %>
          </div>
        </section>
        <% } %>

        <!-- 11. Alternatives & Similar Projects -->
        <% const alternatives = record.analysis.alternatives || {}; %>
        <% if (isSectionVisible('alternatives', record.analysis)) { %>
        <section class="analysis-section" id="section-alternatives" aria-labelledby="heading-alternatives">
          <header class="section-header-row">
            <div class="section-title-wrap">
              <span class="section-number"><%= sectionNumMap['alternatives'] %></span>
              <h2 id="heading-alternatives" class="section-title"><%= alternatives.title || 'Alternatives & Similar Projects' %></h2>
            </div>
            <% if (alternatives.isIncomplete || alternatives.status === 'not_documented') { %>
              <span class="badge badge-amber">Not documented</span>
            <% } %>
          </header>
          <div class="section-body">
            <% 
              const validAlternatives = toArr(alternatives.comparableProjects || alternatives.similarProjects).filter(hasContent);
              if (validAlternatives.length > 0) { 
            %>
              <h3>Comparable Projects</h3>
              <ul>
                <% validAlternatives.forEach(proj => { %>
                  <li>
                    <%- formatItem(proj) %>
                  </li>
                <% }); %>
              </ul>
            <% } %>

            <% if (alternatives.sources && alternatives.sources.filter(hasContent).length > 0) { %>
              <div class="section-sources-row">
                <span class="sources-label">Sources:</span>
                <% alternatives.sources.filter(hasContent).forEach(src => { %>
                  <%- markdownService.renderSourceBadge(src, record.url) %>
                <% }); %>
              </div>
            <% } %>
          </div>
        </section>
        <% } %>

        <!-- 12. Official Resources -->
        <% const resources = record.analysis.resources || {}; %>
        <% if (isSectionVisible('resources', record.analysis)) { %>
        <section class="analysis-section" id="section-resources" aria-labelledby="heading-resources">
          <header class="section-header-row">
            <div class="section-title-wrap">
              <span class="section-number"><%= sectionNumMap['resources'] %></span>
              <h2 id="heading-resources" class="section-title"><%= resources.title || 'Official Resources' %></h2>
            </div>
          </header>
          <div class="section-body">
            <ul>
              <li><strong>Repository:</strong> <a href="<%= record.url %>" target="_blank" rel="noopener noreferrer"><%= record.url %></a></li>
              <% if (resources.documentationUrl && hasContent(resources.documentationUrl)) { %>
                <li><strong>Documentation:</strong> <a href="<%= resources.documentationUrl %>" target="_blank" rel="noopener noreferrer"><%= resources.documentationUrl %></a></li>
              <% } %>
              <% if (resources.issueTrackerUrl && hasContent(resources.issueTrackerUrl)) { %>
                <li><strong>Issues:</strong> <a href="<%= resources.issueTrackerUrl %>" target="_blank" rel="noopener noreferrer"><%= resources.issueTrackerUrl %></a></li>
              <% } %>
            </ul>

            <% 
              const validCommunity = (resources.communityLinks || []).filter(hasContent);
              if (validCommunity.length > 0) { 
            %>
              <h3>Community Links</h3>
              <ul>
                <% validCommunity.forEach(comm => { %>
                  <li><a href="<%= comm.url %>" target="_blank" rel="noopener noreferrer"><%= comm.title || comm.url %></a></li>
                <% }); %>
              </ul>
            <% } %>
          </div>
        </section>
        <% } %>

      <% } else { %>
        <!-- Placeholder for dynamic client-side rendering -->
        <div id="client-document-placeholder" class="analysis-section">
          <p>Loading analysis from history or cache...</p>
        </div>
      <% } %>
    </article>

    <!-- Right Side Evidence Rail (Desktop only) -->
    <aside class="analysis-evidence-rail" aria-label="Analysis Evidence & Metadata">
      <div class="evidence-card">
        <div class="evidence-header">Analysis Metadata</div>
        <div class="evidence-stat-row">
          <span class="evidence-stat-label">Revision</span>
          <span class="evidence-stat-val font-mono"><%= record?.revision ? record.revision.substring(0, 7) : '—' %></span>
        </div>
        <div class="evidence-stat-row">
          <span class="evidence-stat-label">Completeness</span>
          <span class="evidence-stat-val"><%= record?.score ?? 100 %>%</span>
        </div>
        <div class="evidence-stat-row">
          <span class="evidence-stat-label">Analyzed</span>
          <span class="evidence-stat-val text-xs"><%= record?.analyzedAt ? new Date(record.analyzedAt).toLocaleDateString() : 'Just now' %></span>
        </div>
        <div class="evidence-stat-row">
          <span class="evidence-stat-label">Sections</span>
          <span class="evidence-stat-val"><%= visibleSections.length %> Sections</span>
        </div>
      </div>
    </aside>
  </main>

  <div id="gitex-toast" class="gitex-toast" role="status" aria-live="polite">
    <span id="toast-message">Copied!</span>
  </div>

  <%- include('partials/footer') %>

  <!-- Pass server data safely to client script -->
  <script>
    window.__GITEX_RECORD__ = <%- record ? JSON.stringify(record) : 'null' %>;
    window.__ORIGINAL_RECORD__ = <%- (typeof originalRecord !== 'undefined' && originalRecord) ? JSON.stringify(originalRecord) : (record ? JSON.stringify(record) : 'null') %>;
    window.__RECORD_ID__ = <%- recordId ? JSON.stringify(recordId) : 'null' %>;
    window.__CURRENT_LANG__ = '<%= typeof currentLang !== "undefined" ? currentLang : "en" %>';
    window.__SECTION_TITLES_EN__ = <%- JSON.stringify(typeof sectionTitlesEn !== 'undefined' ? sectionTitlesEn : {}) %>;
    window.__SECTION_TITLES_ID__ = <%- JSON.stringify(typeof sectionTitlesId !== 'undefined' ? sectionTitlesId : {}) %>;
  </script>
  <script src="/js/graph-explorer/graph.parser.js"></script>
  <script src="/js/graph-explorer/graph.engine.js"></script>
  <script src="/js/graph-explorer/graph.controller.js"></script>
  <script type="module" src="/js/analysis.js"></script>
</body>
</html>

